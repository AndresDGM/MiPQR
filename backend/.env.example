PORT=3000

# Conexion a PostgreSQL (coincide con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mipqr

# Autenticacion JWT
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Clave DES compartida con el frontend (exactamente 8 caracteres)
DES_KEY=claveDES

# Claves RSA para proteger las contrasenas en la base de datos.
# Se generan con: npm run rsa:generate (las agrega a .env)
RSA_N=
RSA_E=10001
RSA_D=

# Almacenamiento seguro de documentos adjuntos
STORAGE_PATH=./uploads/adjuntos
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=5
MAX_TOTAL_SIZE_MB=25

# Servicio de Correo Electrónico (SMTP)
# Si no se configuran credenciales SMTP, el servicio opera en modo desarrollo/simulado
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MiPQR Clinica Dolormed <notificaciones@mipqr.com>
SMTP_SECURE=false

# URL base del cliente web para enlaces en correos
APP_URL=http://localhost:4200

# Integracion con microservicio de IA (Python / FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000

# Alertas de vencimiento (SLA) y WhatsApp (Adapter: evolution | twilio | simulated)
# Si no se configuran credenciales del proveedor activo, opera en modo simulado
PQR_SLA_DAYS=8
SLA_ALERT_HOURS_BEFORE=48
SLA_CHECK_INTERVAL_MINUTES=60
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=mipqr
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=
