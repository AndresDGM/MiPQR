PORT=3000

# Conexion a PostgreSQL (coincide con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mipqr

# Autenticacion JWT
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Clave DES compartida con el frontend (exactamente 8 caracteres)
DES_KEY=claveDES

# Claves RSA para proteger las contrasenas en la base de datos.
# Se generan con: npm run rsa:generate (las agrega a .env)
RSA_N=
RSA_E=10001
RSA_D=

# Almacenamiento seguro de documentos adjuntos
STORAGE_PATH=./uploads/adjuntos
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=5
MAX_TOTAL_SIZE_MB=25
